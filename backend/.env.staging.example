# Staging Environment Configuration Template (DO NOT CONNECT TO PRODUCTION DATABASE)
NODE_ENV=staging
PORT=5500
DATABASE_URL="postgresql://staging_user:staging_pass@staging-db.internal:5432/ssiu_erp_staging?schema=public"
JWT_SECRET="staging-jwt-secret-key-must-be-secure"
JWT_EXPIRATION="8h"
CORS_ORIGINS="https://staging.swarrnim.edu.in,https://staging-erp.swarrnim.edu.in"
STORAGE_TYPE="s3"
S3_BUCKET_NAME="ssiu-erp-staging-documents"
FILE_UPLOAD_DIR="/var/storage/staging"
LOG_LEVEL="info"
