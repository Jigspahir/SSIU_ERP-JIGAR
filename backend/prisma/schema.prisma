// SSIU ERP — Prisma Database Schema
// Backends 1–8: Core Masters, Auth, RBAC, Workflow, Academic, Exam, Fees, Store, Purchase, Asset

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// 1. GOVERNANCE & ACADEMIC STRUCTURE MASTERS
// ──────────────────────────────────────────────────────────────────────────────

model University {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  tagline   String?
  address   String?
  website   String?
  email     String?
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institutes Institute[]
}

model Institute {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  shortName    String?
  universityId String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university  University   @relation(fields: [universityId], references: [id])
  departments Department[]
  students    Student[]
  faculty     Faculty[]
  employees   Employee[]
  researchProjects ResearchProject[]
  libraries        Library[]

  @@index([universityId])
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  instituteId String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id])
  programs  Program[]
  students  Student[]
  faculty   Faculty[]
  employees Employee[]
  researchProjects ResearchProject[]

  @@index([instituteId])
}

model Program {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  shortName    String?
  departmentId String
  durationYears Int     @default(4)
  degreeType   String   @default("UG") // UG | PG | DIPLOMA | PHD
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department    @relation(fields: [departmentId], references: [id])
  batches      Batch[]
  subjects     Subject[]
  feeStructures FeeStructure[]
  exams        Exam[]
  digitalResources DigitalResource[]

  @@index([departmentId])
}

model AcademicYear {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. 2024-25
  startYear Int
  endYear   Int
  isCurrent Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches              Batch[]
  studentMentorMappings StudentMentorMapping[]
}

model Batch {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. CSE-2024
  programId    String
  academicYearId String
  startYear    Int
  endYear      Int
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program      Program      @relation(fields: [programId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  semesters    Semester[]
  students     Student[]

  @@index([programId])
  @@index([academicYearId])
}

model Semester {
  id           String   @id @default(uuid())
  batchId      String
  semesterNumber Int
  name         String   // e.g. Semester 1
  startDate    DateTime?
  endDate      DateTime?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batch         Batch        @relation(fields: [batchId], references: [id])
  divisions     Division[]
  subjects      Subject[]
  feeStructures FeeStructure[]
  examForms     ExamForm[]
  examSchedules ExamSchedule[]

  studentFacultyMappings StudentFacultyMapping[]
  facultySubjectMappings FacultySubjectMapping[]

  @@unique([batchId, semesterNumber])
  @@index([batchId])
}

model Division {
  id         String   @id @default(uuid())
  semesterId String
  name       String   // A, B, C
  capacity   Int      @default(60)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  semester Semester @relation(fields: [semesterId], references: [id])
  students Student[]

  studentFacultyMappings StudentFacultyMapping[]
  facultySubjectMappings FacultySubjectMapping[]

  @@unique([semesterId, name])
  @@index([semesterId])
}

model Subject {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  programId   String
  semesterId  String?
  credits     Int      @default(3)
  subjectType String   @default("THEORY") // THEORY | PRACTICAL | LAB | ELECTIVE
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program  Program  @relation(fields: [programId], references: [id])
  semester Semester? @relation(fields: [semesterId], references: [id])

  studentFacultyMappings StudentFacultyMapping[]
  facultySubjectMappings FacultySubjectMapping[]
  examSchedules          ExamSchedule[]
  examResults            ExamResult[]
  books                  Book[]
  digitalResources       DigitalResource[]

  @@index([programId])
  @@index([semesterId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 2. PEOPLE MASTERS — STUDENT & FACULTY
// ──────────────────────────────────────────────────────────────────────────────

model Student {
  id           String   @id @default(uuid())
  erpId        String   @unique // STU000001
  enrollmentNo String   @unique
  firstName    String
  middleName   String?
  lastName     String
  email        String   @unique
  phone        String?
  dateOfBirth  DateTime?
  gender       String?
  instituteId  String
  departmentId String
  batchId      String
  currentDivisionId String?
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE | GRADUATED | DROPPED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institute  Institute  @relation(fields: [instituteId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  batch      Batch      @relation(fields: [batchId], references: [id])
  division   Division?  @relation(fields: [currentDivisionId], references: [id])
  user       User?

  studentFacultyMappings StudentFacultyMapping[]
  studentMentorMappings  StudentMentorMapping[]
  examForms              ExamForm[]
  examResults            ExamResult[]
  feeAccounts            StudentFeeAccount[]
  transportApplications  TransportApplication[]
  transportAllotments    TransportAllotment[]
  transportPasses        TransportPass[]
  transportAttendances   TransportAttendance[]
  transportComplaints    TransportComplaint[]
  startupMemberships     StartupMember[]
  placementApplications  PlacementApplication[]
  trainingEnrollments    TrainingEnrollment[]
  alumniProfile          AlumniProfile?
  serviceRequests        StudentServiceRequest[]
  certificates           Certificate[]
  hallTickets            HallTicket[]
  resultSummaries        ResultSummary[]
  revaluations           RevaluationRequest[]
  hostelApplications     HostelApplication[]
  hostelAllotments       HostelAllotment[]
  hostelAttendances      HostelAttendance[]
  outpassRequests        OutpassRequest[]
  hostelComplaints       HostelComplaint[]
  messEnrollments        MessEnrollment[]

  @@index([instituteId])
  @@index([departmentId])
  @@index([batchId])
}

model Faculty {
  id           String   @id @default(uuid())
  erpId        String   @unique // FAC000001
  employeeCode String   @unique
  firstName    String
  middleName   String?
  lastName     String
  email        String   @unique
  phone        String?
  designation  String?
  instituteId  String
  departmentId String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institute  Institute  @relation(fields: [instituteId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  user       User?

  studentFacultyMappings StudentFacultyMapping[]
  studentMentorMappings  StudentMentorMapping[]  @relation("MentorFaculty")
  facultySubjectMappings FacultySubjectMapping[]
  researchMemberships    ResearchMember[]
  startupMentorships     StartupMentor[]

  @@index([instituteId])
  @@index([departmentId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 3. AUTH & USER ACCOUNT SYSTEM
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  erpId                String    @unique
  username             String    @unique
  passwordHash         String
  accountStatus        String    @default("ACTIVE") // ACTIVE | INACTIVE | LOCKED | SUSPENDED
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  studentId            String?   @unique
  facultyId            String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  student Student? @relation(fields: [studentId], references: [id])
  faculty Faculty? @relation(fields: [facultyId], references: [id])

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  loginAudits        LoginAudit[]
  userRoles          UserRole[]

  workflowInstancesRequested WorkflowInstance[] @relation("RequestedByRelation")
  workflowHistories          WorkflowHistory[]  @relation("HistoryPerformedBy")
  delegationsGiven           WorkflowDelegation[] @relation("DelegatorRelation")
  delegationsReceived        WorkflowDelegation[] @relation("DelegateeRelation")

  // Store & Purchase
  stockIssuesTo      StockIssue[]    @relation("IssuedToUser")
  stockIssuesBy      StockIssue[]    @relation("IssuedByUser")
  purchaseRequestsBy PurchaseRequest[] @relation("RequestedByUser")
  assetAssignments   AssetAssignment[] @relation("AssignedToUser")
  employee           Employee?         @relation("UserEmployee")
  itTickets          ITTicket[]
  campusRequests     CampusServiceRequest[]
  researchProjectsCreated ResearchProject[] @relation("ResearchCreatedBy")
  innovations             InnovationIdea[]  @relation("InnovationCreator")
  placementApplications   PlacementApplication[]
  userOrgReporting        UserOrgReporting?
  userRoleHistories       UserRoleHistory[]
  workDiaries             WorkDiary[]
  workTasks               WorkTask[]
  personalAppointments    PersonalAppointment[]
  workFollowUps           WorkFollowUp[]
  personalNotes           PersonalNote[]
  communicationsCreated   Communication[]       @relation("CommCreator")
  libraryMemberships      LibraryMembership[]

  @@index([username])
  @@index([erpId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAudit {
  id        String   @id @default(uuid())
  userId    String?
  username  String
  ipAddress String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// 4. RBAC — ROLE, PERMISSION & AUTHORITY ENGINE
// ──────────────────────────────────────────────────────────────────────────────

model Role {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?
  authorityLevel Int      @default(10)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([authorityLevel])
}

model UserRole {
  userId      String
  roleId      String
  assignedAt  DateTime @default(now())
  assignedBy  String?
  scopeType   String   @default("UNIVERSITY") // UNIVERSITY | INSTITUTE | DEPARTMENT | PROGRAM
  scopeId     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  action      String   // VIEW | CREATE | EDIT | DELETE | APPROVE | REJECT | PUBLISH | EXPORT | IMPORT | CONFIGURE | ASSIGN
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@index([action])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RbacAudit {
  id                String   @id @default(uuid())
  performedByUserId String?
  targetUserId      String?
  targetRoleId      String?
  action            String   // ROLE_ASSIGNED | ROLE_REMOVED | ROLE_CREATED | ROLE_UPDATED | PERMISSIONS_UPDATED
  details           String?
  createdAt         DateTime @default(now())

  @@index([targetUserId])
  @@index([performedByUserId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 5. WORKFLOW & APPROVAL ENGINE
// ──────────────────────────────────────────────────────────────────────────────

model WorkflowDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  requestType String
  name        String
  description String?
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@index([code])
  @@index([module])
}

model WorkflowStep {
  id                   String   @id @default(uuid())
  workflowDefinitionId String
  stepNumber           Int
  stepName             String
  requiredRoleCode     String
  minAuthorityLevel    Int      @default(10)
  dataScope            String   @default("OWN")
  actionsAllowed       String
  slaHours             Int?     @default(24)
  isRequired           Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)

  @@unique([workflowDefinitionId, stepNumber])
  @@index([workflowDefinitionId])
}

model WorkflowInstance {
  id                    String    @id @default(uuid())
  workflowDefinitionId  String
  entityId              String
  module                String
  currentStatus         String    @default("DRAFT")
  currentStepNumber     Int       @default(1)
  currentAssigneeRoleId String?
  requestedByUserId     String
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  dueDate               DateTime?
  priority              String    @default("NORMAL")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  requestedByUser    User               @relation("RequestedByRelation", fields: [requestedByUserId], references: [id])
  histories          WorkflowHistory[]

  @@index([workflowDefinitionId])
  @@index([entityId])
  @@index([currentStatus])
  @@index([requestedByUserId])
}

model WorkflowHistory {
  id                        String   @id @default(uuid())
  instanceId                String
  action                    String
  fromStatus                String
  toStatus                  String
  performedByUserId         String
  performedByRoleId         String?
  performedByAuthorityLevel Int?
  stepNumber                Int
  comments                  String?
  attachmentUrl             String?
  createdAt                 DateTime @default(now())

  instance        WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  performedByUser User             @relation("HistoryPerformedBy", fields: [performedByUserId], references: [id])

  @@index([instanceId])
  @@index([performedByUserId])
}

model WorkflowDelegation {
  id                String    @id @default(uuid())
  delegatorUserId   String
  delegateeUserId   String
  minAuthorityLevel Int       @default(10)
  startDate         DateTime
  endDate           DateTime
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  delegatorUser User @relation("DelegatorRelation", fields: [delegatorUserId], references: [id], onDelete: Cascade)
  delegateeUser User @relation("DelegateeRelation", fields: [delegateeUserId], references: [id], onDelete: Cascade)

  @@index([delegatorUserId])
  @@index([delegateeUserId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 6. ACADEMIC MAPPING & COURSE RELATION MASTERS
// ──────────────────────────────────────────────────────────────────────────────

model StudentFacultyMapping {
  id               String   @id @default(uuid())
  studentId        String
  facultyId        String
  subjectId        String
  semesterId       String
  divisionId       String
  mappingType      String   @default("COURSE_TEACHER")
  status           String   @default("ACTIVE")
  assignedAt       DateTime @default(now())
  assignedByUserId String?

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty  Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, mappingType])
  @@index([studentId])
  @@index([facultyId])
  @@index([subjectId])
}

model StudentMentorMapping {
  id               String   @id @default(uuid())
  studentId        String
  mentorFacultyId  String
  academicYearId   String
  status           String   @default("ACTIVE")
  assignedAt       DateTime @default(now())
  assignedByUserId String?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty      Faculty      @relation("MentorFaculty", fields: [mentorFacultyId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([mentorFacultyId])
}

model FacultySubjectMapping {
  id         String   @id @default(uuid())
  facultyId  String
  subjectId  String
  divisionId String
  semesterId String
  status     String   @default("ACTIVE")
  assignedAt DateTime @default(now())

  faculty  Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([facultyId, subjectId, divisionId])
  @@index([facultyId])
  @@index([subjectId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 7. EXAMINATION & FEES MANAGEMENT
// ──────────────────────────────────────────────────────────────────────────────

// --- EXAM SECTION ---

model ExamType {
  id          String   @id @default(uuid())
  code        String   @unique  // INTERNAL | EXTERNAL | PRACTICAL | VIVA | MIDTERM | ENDTERM
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams Exam[]
}

model Exam {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  examTypeId   String
  programId    String
  academicYearCode String  // e.g. 2024-25
  semesterNumber   Int
  startDate    DateTime?
  endDate      DateTime?
  status       String   @default("UPCOMING") // UPCOMING | ACTIVE | COMPLETED | CANCELLED
  createdByUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  examType      ExamType       @relation(fields: [examTypeId], references: [id])
  program       Program        @relation(fields: [programId], references: [id])
  formWindows   ExamFormWindow[]
  examForms     ExamForm[]
  schedules     ExamSchedule[]

  @@index([examTypeId])
  @@index([programId])
  @@index([status])
}

model ExamFormWindow {
  id              String    @id @default(uuid())
  examId          String
  windowOpen      DateTime
  windowClose     DateTime
  lateWindowClose DateTime?
  examFee         Decimal   @default(0) @db.Decimal(10, 2)
  lateFee         Decimal   @default(0) @db.Decimal(10, 2)
  maxAttempts     Int       @default(1)
  status          String    @default("ACTIVE") // ACTIVE | CLOSED | UPCOMING
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  examForms ExamForm[]

  @@index([examId])
  @@index([status])
}

model ExamForm {
  id               String    @id @default(uuid())
  examId           String
  examFormWindowId String
  studentId        String
  semesterId       String
  attemptNumber    Int       @default(1)
  status           String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | CANCELLED
  submittedAt      DateTime?
  feePaid          Boolean   @default(false)
  totalFee         Decimal   @default(0) @db.Decimal(10, 2)
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  exam           Exam           @relation(fields: [examId], references: [id])
  examFormWindow ExamFormWindow @relation(fields: [examFormWindowId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])
  semester       Semester       @relation(fields: [semesterId], references: [id])
  results        ExamResult[]

  @@unique([examId, studentId, attemptNumber])
  @@index([examId])
  @@index([studentId])
  @@index([status])
}

model ExamSchedule {
  id           String    @id @default(uuid())
  examId       String
  subjectId    String
  semesterId   String
  examDate     DateTime
  startTime    String    // HH:mm format
  endTime      String
  venue        String?
  invigilator  String?
  status       String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | POSTPONED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])
  results  ExamResult[]

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
  @@index([examDate])
}

model ExamResult {
  id             String    @id @default(uuid())
  examFormId     String
  studentId      String
  subjectId      String
  examScheduleId String?
  marksObtained  Decimal?  @db.Decimal(6, 2)
  maxMarks       Decimal   @default(100) @db.Decimal(6, 2)
  grade          String?   // A+, A, B+, B, C, D, F
  gradePoints    Decimal?  @db.Decimal(4, 2)
  isPassed       Boolean?
  isAbsent       Boolean   @default(false)
  resultStatus   String    @default("PENDING") // PENDING | DECLARED | WITHHELD | CANCELLED
  publishedAt    DateTime?
  enteredByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  examForm     ExamForm      @relation(fields: [examFormId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id])
  subject      Subject       @relation(fields: [subjectId], references: [id])
  examSchedule ExamSchedule? @relation(fields: [examScheduleId], references: [id])

  @@unique([examFormId, subjectId])
  @@index([studentId])
  @@index([subjectId])
  @@index([resultStatus])
}

// --- FEES SECTION ---

model FeeHead {
  id          String   @id @default(uuid())
  code        String   @unique   // TUITION, HOSTEL, LAB, LIBRARY, EXAM, TRANSPORT, OTHER
  name        String
  description String?
  isOptional  Boolean  @default(false)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feeStructureItems FeeStructureItem[]
  feePaymentItems   FeePaymentItem[]
}

model FeeStructure {
  id           String   @id @default(uuid())
  programId    String
  semesterId   String
  academicYearCode String
  name         String
  totalAmount  Decimal  @db.Decimal(12, 2)
  dueDate      DateTime?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program  Program  @relation(fields: [programId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])
  items    FeeStructureItem[]
  accounts StudentFeeAccount[]

  @@unique([programId, semesterId, academicYearCode])
  @@index([programId])
  @@index([semesterId])
}

model FeeStructureItem {
  id             String   @id @default(uuid())
  feeStructureId String
  feeHeadId      String
  amount         Decimal  @db.Decimal(10, 2)
  isOptional     Boolean  @default(false)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id])

  @@unique([feeStructureId, feeHeadId])
  @@index([feeStructureId])
}

model StudentFeeAccount {
  id             String   @id @default(uuid())
  studentId      String
  feeStructureId String
  academicYearCode String
  totalDue       Decimal  @db.Decimal(12, 2)
  totalPaid      Decimal  @default(0) @db.Decimal(12, 2)
  totalDiscount  Decimal  @default(0) @db.Decimal(12, 2)
  balanceDue     Decimal  @db.Decimal(12, 2)
  status         String   @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE | WAIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     FeePayment[]
  discounts    FeeDiscount[]
  refunds      FeeRefund[]

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@index([status])
}

model FeePayment {
  id               String    @id @default(uuid())
  receiptNo        String    @unique   // FEE-2024-000001
  feeAccountId     String
  amount           Decimal   @db.Decimal(12, 2)
  paymentMode      String    // CASH | CHEQUE | DD | ONLINE | UPI | NEFT | RTGS
  transactionRef   String?
  paymentDate      DateTime  @default(now())
  collectedByUserId String?
  status           String    @default("CONFIRMED") // CONFIRMED | PENDING | FAILED | REFUNDED
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  feeAccount StudentFeeAccount @relation(fields: [feeAccountId], references: [id])
  items      FeePaymentItem[]
  refunds    FeeRefund[]

  @@index([feeAccountId])
  @@index([paymentDate])
  @@index([status])
}

model FeePaymentItem {
  id          String  @id @default(uuid())
  paymentId   String
  feeHeadId   String
  amount      Decimal @db.Decimal(10, 2)

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeHead FeeHead    @relation(fields: [feeHeadId], references: [id])

  @@unique([paymentId, feeHeadId])
}

model FeeDiscount {
  id             String   @id @default(uuid())
  feeAccountId   String
  discountType   String   // SCHOLARSHIP | MERIT | STAFF_WARD | GOVERNMENT | MANAGEMENT | OTHER
  description    String?
  amount         Decimal  @db.Decimal(10, 2)
  approvedByUserId String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  feeAccount StudentFeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)

  @@index([feeAccountId])
}

model FeeRefund {
  id             String    @id @default(uuid())
  feeAccountId   String
  paymentId      String
  refundAmount   Decimal   @db.Decimal(10, 2)
  reason         String
  refundMode     String    @default("ONLINE")
  processedAt    DateTime?
  processedByUserId String?
  status         String    @default("PENDING") // PENDING | PROCESSED | REJECTED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  feeAccount StudentFeeAccount @relation(fields: [feeAccountId], references: [id])
  payment    FeePayment        @relation(fields: [paymentId], references: [id])

  @@index([feeAccountId])
  @@index([status])
}


// ──────────────────────────────────────────────────────────────────────────────
// 8. STORE, PURCHASE & ASSET MANAGEMENT

// ──────────────────────────────────────────────────────────────────────────────

// --- CENTRAL STORE ---

model ItemCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  parentId    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  items    ItemMaster[]

  @@index([parentId])
}

model UnitOfMeasurement {
  id           String   @id @default(uuid())
  code         String   @unique   // NOS, KG, LTR, PCS, BOX, MTR, SET
  name         String
  abbreviation String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  items ItemMaster[]
}

model ItemMaster {
  id              String   @id @default(uuid())
  itemCode        String   @unique
  name            String
  description     String?
  categoryId      String
  unitId          String
  minStockLevel   Int      @default(0)
  reorderLevel    Int      @default(5)
  reorderQuantity Int      @default(10)
  currentStock    Int      @default(0)
  unitPrice       Decimal  @default(0) @db.Decimal(12, 2)
  location        String?  // Storage location / rack
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        ItemCategory  @relation(fields: [categoryId], references: [id])
  unit            UnitOfMeasurement @relation(fields: [unitId], references: [id])
  stockLedger     StockLedger[]
  stockAdjustments StockAdjustment[]
  stockIssues     StockIssue[]
  stockReturns    StockReturn[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  quotationItems       QuotationItem[]

  @@index([categoryId])
  @@index([currentStock])
}

model StockLedger {
  id              String   @id @default(uuid())
  itemId          String
  transactionType String   // STOCK_IN | STOCK_OUT | ADJUSTMENT | ISSUE | RETURN | TRANSFER
  quantity        Int
  balanceAfter    Int
  referenceType   String?  // GRN | ISSUE | RETURN | ADJUSTMENT | PURCHASE_ORDER
  referenceId     String?
  unitPrice       Decimal? @db.Decimal(12, 2)
  totalValue      Decimal? @db.Decimal(12, 2)
  remarks         String?
  performedByUserId String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  item ItemMaster @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([transactionType])
  @@index([transactionDate])
}

model StockAdjustment {
  id              String   @id @default(uuid())
  adjustmentNo    String   @unique    // ADJ-2024-000001
  itemId          String
  adjustmentType  String   // DAMAGE | LOSS | CORRECTION | EXPIRY | TRANSFER
  quantityBefore  Int
  quantityChanged Int      // positive or negative
  quantityAfter   Int
  reason          String
  approvedByUserId String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adjustmentDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item ItemMaster @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([adjustmentType])
  @@index([status])
}

model StockIssue {
  id            String    @id @default(uuid())
  issueNo       String    @unique    // ISS-2024-000001
  itemId        String
  quantityIssued Int
  issuedToUserId String?
  issuedToDepartment String?
  issuedByUserId String
  purpose       String?
  issueDate     DateTime  @default(now())
  expectedReturnDate DateTime?
  status        String    @default("ISSUED") // ISSUED | PARTIALLY_RETURNED | FULLY_RETURNED | LOST
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  item         ItemMaster  @relation(fields: [itemId], references: [id])
  issuedToUser User?       @relation("IssuedToUser", fields: [issuedToUserId], references: [id])
  issuedByUser User        @relation("IssuedByUser", fields: [issuedByUserId], references: [id])
  returns      StockReturn[]

  @@index([itemId])
  @@index([issuedToUserId])
  @@index([status])
}

model StockReturn {
  id               String   @id @default(uuid())
  returnNo         String   @unique   // RET-2024-000001
  issueId          String
  itemId           String
  quantityReturned Int
  returnCondition  String   @default("GOOD") // GOOD | DAMAGED | PARTIAL
  returnDate       DateTime @default(now())
  receivedByUserId String?
  remarks          String?
  createdAt        DateTime @default(now())

  issue      StockIssue @relation(fields: [issueId], references: [id])
  item       ItemMaster @relation(fields: [itemId], references: [id])

  @@index([issueId])
  @@index([itemId])
}

// --- PURCHASE MODULE ---

model Vendor {
  id            String   @id @default(uuid())
  vendorCode    String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNo         String?
  panNo         String?
  bankAccount   String?
  bankIfsc      String?
  bankName      String?
  rating        Int      @default(3) // 1-5 star rating
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  invoices       PurchaseInvoice[]

  @@index([status])
}

model PurchaseRequest {
  id                  String    @id @default(uuid())
  requestNo           String    @unique    // PR-2024-000001
  requestedByUserId   String
  departmentId        String?
  instituteId         String?
  requestDate         DateTime  @default(now())
  requiredByDate      DateTime?
  priority            String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status              String    @default("DRAFT")
  // DRAFT | SUBMITTED | HOD_VERIFIED | HOI_APPROVED | PURCHASE_PROCESSING | PO_ISSUED | COMPLETED | REJECTED | CANCELLED
  remarks             String?
  workflowInstanceId  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requestedByUser User     @relation("RequestedByUser", fields: [requestedByUserId], references: [id])
  items           PurchaseRequestItem[]
  quotations      Quotation[]
  purchaseOrders  PurchaseOrder[]

  @@index([requestedByUserId])
  @@index([status])
  @@index([requestDate])
}

model PurchaseRequestItem {
  id                String   @id @default(uuid())
  purchaseRequestId String
  itemId            String
  quantityRequested Int
  estimatedUnitPrice Decimal? @db.Decimal(12, 2)
  specifications    String?
  remarks           String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  item            ItemMaster      @relation(fields: [itemId], references: [id])

  @@index([purchaseRequestId])
  @@index([itemId])
}

model Quotation {
  id                String    @id @default(uuid())
  quotationNo       String    @unique   // QT-2024-000001
  purchaseRequestId String?
  vendorId          String
  quotationDate     DateTime  @default(now())
  validUntil        DateTime?
  totalAmount       Decimal   @default(0) @db.Decimal(12, 2)
  termsConditions   String?
  deliveryDays      Int?
  isSelected        Boolean   @default(false)
  status            String    @default("RECEIVED") // RECEIVED | UNDER_EVALUATION | SELECTED | REJECTED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  items           QuotationItem[]

  @@index([purchaseRequestId])
  @@index([vendorId])
  @@index([status])
}

model QuotationItem {
  id           String   @id @default(uuid())
  quotationId  String
  itemId       String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  totalPrice   Decimal  @db.Decimal(12, 2)
  gstPercent   Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount    Decimal  @default(0) @db.Decimal(10, 2)
  remarks      String?

  quotation Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item      ItemMaster @relation(fields: [itemId], references: [id])

  @@index([quotationId])
}

model PurchaseOrder {
  id                String    @id @default(uuid())
  poNo              String    @unique    // PO-2024-000001
  purchaseRequestId String?
  vendorId          String
  orderDate         DateTime  @default(now())
  expectedDelivery  DateTime?
  totalAmount       Decimal   @default(0) @db.Decimal(12, 2)
  gstAmount         Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal   @default(0) @db.Decimal(12, 2)
  terms             String?
  status            String    @default("DRAFT")
  // DRAFT | APPROVED | SENT_TO_VENDOR | PARTIALLY_RECEIVED | FULLY_RECEIVED | CANCELLED | CLOSED
  approvedByUserId  String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  invoices        PurchaseInvoice[]

  @@index([vendorId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  gstPercent      Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount       Decimal  @default(0) @db.Decimal(10, 2)
  quantityReceived Int     @default(0)
  remarks         String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          ItemMaster    @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String    @id @default(uuid())
  grnNo           String    @unique    // GRN-2024-000001
  purchaseOrderId String
  receivedDate    DateTime  @default(now())
  receivedByUserId String?
  vehicleNo       String?
  dcNo            String?   // Delivery Challan No
  invoiceRef      String?
  remarks         String?
  status          String    @default("RECEIVED") // RECEIVED | VERIFIED | REJECTED | PARTIAL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([receivedDate])
}

model GoodsReceiptItem {
  id             String   @id @default(uuid())
  grnId          String
  itemId         String
  quantityOrdered  Int
  quantityReceived Int
  quantityRejected Int    @default(0)
  unitPrice      Decimal  @db.Decimal(12, 2)
  condition      String   @default("GOOD") // GOOD | DAMAGED | EXPIRED
  remarks        String?

  grn  GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item ItemMaster   @relation(fields: [itemId], references: [id])

  @@index([grnId])
  @@index([itemId])
}

model PurchaseInvoice {
  id              String    @id @default(uuid())
  invoiceNo       String    @unique
  vendorInvoiceNo String?
  purchaseOrderId String
  vendorId        String
  invoiceDate     DateTime
  dueDate         DateTime?
  subtotal        Decimal   @db.Decimal(12, 2)
  gstAmount       Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal   @db.Decimal(12, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  balanceAmount   Decimal   @db.Decimal(12, 2)
  paymentStatus   String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  status          String    @default("RECEIVED") // RECEIVED | VERIFIED | APPROVED | PAID | REJECTED
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  vendor        Vendor        @relation(fields: [vendorId], references: [id])

  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([paymentStatus])
}

// --- ASSET MANAGEMENT ---

model AssetCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  parentId    String?
  depreciationRate Decimal @default(0) @db.Decimal(5, 2) // % per year
  usefulLifeYears  Int     @default(5)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parentId], references: [id])
  children AssetCategory[] @relation("AssetCategoryHierarchy")
  assets   Asset[]

  @@index([parentId])
}

model Asset {
  id               String    @id @default(uuid())
  assetTag         String    @unique    // AST-IT-000001
  name             String
  description      String?
  categoryId       String
  serialNo         String?
  modelNo          String?
  manufacturer     String?
  purchaseDate     DateTime?
  purchasePrice    Decimal?  @db.Decimal(12, 2)
  currentValue     Decimal?  @db.Decimal(12, 2)
  warrantyExpiry   DateTime?
  location         String?
  buildingBlock    String?
  floor            String?
  roomNo           String?
  assignedDeptId   String?
  status           String    @default("AVAILABLE")
  // AVAILABLE | ASSIGNED | UNDER_MAINTENANCE | DISPOSED | LOST | DAMAGED
  poNo             String?   // Linked purchase order number
  grnNo            String?   // Linked GRN number
  invoiceRef       String?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category     AssetCategory    @relation(fields: [categoryId], references: [id])
  assignments  AssetAssignment[]
  transfers    AssetTransfer[]
  maintenanceLogs AssetMaintenance[]
  disposals    AssetDisposal[]

  @@index([categoryId])
  @@index([status])
  @@index([assetTag])
}

model AssetAssignment {
  id             String    @id @default(uuid())
  assetId        String
  assignedToUserId String?
  assignedToDeptId String?
  assignedByUserId String?
  assignmentDate DateTime  @default(now())
  returnDate     DateTime?
  purpose        String?
  status         String    @default("ACTIVE") // ACTIVE | RETURNED | TRANSFERRED
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  asset          Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedToUser User? @relation("AssignedToUser", fields: [assignedToUserId], references: [id])

  @@index([assetId])
  @@index([assignedToUserId])
  @@index([status])
}

model AssetTransfer {
  id                  String    @id @default(uuid())
  transferNo          String    @unique   // TRF-2024-000001
  assetId             String
  fromDeptId          String?
  toDeptId            String?
  fromLocation        String?
  toLocation          String?
  transferDate        DateTime  @default(now())
  transferredByUserId String?
  receivedByUserId    String?
  reason              String?
  status              String    @default("COMPLETED") // PENDING | COMPLETED | CANCELLED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
}

model AssetMaintenance {
  id                String    @id @default(uuid())
  maintenanceNo     String    @unique   // MNT-2024-000001
  assetId           String
  maintenanceType   String    // PREVENTIVE | CORRECTIVE | BREAKDOWN | AMC
  description       String
  reportedDate      DateTime  @default(now())
  scheduledDate     DateTime?
  completedDate     DateTime?
  vendor            String?
  cost              Decimal?  @db.Decimal(10, 2)
  partsReplaced     String?
  nextMaintenanceDue DateTime?
  status            String    @default("PENDING")
  // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  performedByUserId String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@index([maintenanceType])
}

model AssetDisposal {
  id              String    @id @default(uuid())
  disposalNo      String    @unique   // DIS-2024-000001
  assetId         String    @unique   // One disposal per asset
  disposalMethod  String    // AUCTION | SCRAPPED | DONATED | SOLD | WRITTEN_OFF
  disposalDate    DateTime  @default(now())
  disposalValue   Decimal?  @db.Decimal(10, 2)
  buyerName       String?
  reason          String
  approvedByUserId String?
  approvedAt      DateTime?
  status          String    @default("PENDING") // PENDING | APPROVED | COMPLETED | CANCELLED
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([disposalDate])
}

// --- HR, LEAVE, ATTENDANCE & PAYROLL ---

model Employee {
  id               String    @id @default(uuid())
  employeeCode     String    @unique
  erpId            String    @unique
  firstName        String
  middleName       String?
  lastName         String
  email            String    @unique
  phone            String?
  designation      String
  employmentType   String    @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | ADHOC | VISITING
  employmentStatus String    @default("ACTIVE")    // ACTIVE | ON_LEAVE | TRANSFERRED | RESIGNED | RETIRED | INACTIVE
  joiningDate      DateTime  @default(now())
  instituteId      String
  departmentId     String
  userId           String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  institute  Institute  @relation(fields: [instituteId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  user       User?      @relation("UserEmployee", fields: [userId], references: [id])

  serviceHistories   EmployeeServiceHistory[]
  leaveBalances      LeaveBalance[]
  leaveApplications  LeaveApplication[]
  attendances        EmployeeAttendance[]
  salaryStructures   SalaryStructure[]
  documents          EmployeeDocument[]
  dutyRequests       DutyRequest[]
  appraisals         AppraisalReview[]
  payslips           Payslip[]
  resignations       Resignation[]

  @@index([instituteId])
  @@index([departmentId])
  @@index([employmentStatus])
}

model EmployeeServiceHistory {
  id            String   @id @default(uuid())
  employeeId    String
  changeType    String   // JOINING | TRANSFER | PROMOTION | DESIGNATION_CHANGE | DEPARTMENT_CHANGE | TRAINING | AWARD
  title         String
  description   String?
  effectiveDate DateTime @default(now())
  remarks       String?
  createdById   String?
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model LeaveType {
  id             String   @id @default(uuid())
  code           String   @unique // CL | SL | EL | ML | PL
  name           String
  maxDaysPerYear Int      @default(12)
  isCarryForward Boolean  @default(false)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  leaveBalances     LeaveBalance[]
  leaveApplications  LeaveApplication[]
}

model LeaveBalance {
  id            String   @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  academicYear  String
  totalAllocated Int     @default(12)
  usedDays      Int      @default(0)
  pendingDays   Int      @default(0)
  remainingDays Int      @default(12)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, academicYear])
  @@index([employeeId])
}

model LeaveApplication {
  id                 String    @id @default(uuid())
  applicationNo      String    @unique // LEV-2026-000001
  employeeId         String
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  totalDays          Int
  reason             String
  status             String    @default("SUBMITTED") // SUBMITTED | VERIFIED | APPROVED | REJECTED | CANCELLED
  workflowInstanceId String?
  appliedAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([status])
}

model EmployeeAttendance {
  id             String    @id @default(uuid())
  employeeId     String
  attendanceDate DateTime  @db.Date
  checkInTime    DateTime?
  checkOutTime   DateTime?
  status         String    @default("PRESENT") // PRESENT | ABSENT | HALF_DAY | ON_LEAVE | LATE
  remarks        String?
  createdAt      DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
}

model SalaryStructure {
  id            String   @id @default(uuid())
  employeeId    String
  basicPay      Decimal  @db.Decimal(12, 2)
  hra           Decimal  @default(0) @db.Decimal(12, 2)
  da            Decimal  @default(0) @db.Decimal(12, 2)
  specialAllow  Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction   Decimal  @default(0) @db.Decimal(12, 2)
  taxDeduction  Decimal  @default(0) @db.Decimal(12, 2)
  netSalary     Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// --- UNIVERSITY HOSTEL & ACCOMMODATION MANAGEMENT ---

model Hostel {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  hostelType  String   @default("STANDARD") // STANDARD | DELUXE | INTERNATIONAL
  gender      String   @default("BOYS")     // BOYS | GIRLS | CO_ED
  instituteId String?
  location    String?
  capacity    Int      @default(100)
  wardenName  String?
  wardenPhone String?
  wardenEmail String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms        HostelRoom[]
  allotments   HostelAllotment[]
  attendances  HostelAttendance[]
  complaints   HostelComplaint[]
  visitors     HostelVisitor[]
  maintenances HostelMaintenance[]

  @@index([gender])
  @@index([status])
}

model HostelRoom {
  id         String   @id @default(uuid())
  hostelId   String
  roomNumber String
  floor      Int      @default(1)
  capacity   Int      @default(2)
  roomType   String   @default("NON_AC") // AC | NON_AC | DELUXE
  facilities String?  // e.g. "Attached Bath, Balcony, Study Table"
  status     String   @default("AVAILABLE") // AVAILABLE | FULL | MAINTENANCE | BLOCKED
  createdAt  DateTime @default(now())

  hostel     Hostel            @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  beds       HostelBed[]
  allotments HostelAllotment[]
  complaints HostelComplaint[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId])
  @@index([status])
}

model HostelBed {
  id         String   @id @default(uuid())
  roomId     String
  bedNumber  String   // e.g. "B1", "B2"
  status     String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | MAINTENANCE | BLOCKED
  createdAt  DateTime @default(now())

  room       HostelRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allotments HostelAllotment[]

  @@unique([roomId, bedNumber])
  @@index([roomId])
  @@index([status])
}

model HostelApplication {
  id                String    @id @default(uuid())
  applicationNo     String    @unique // HST-APP-2026-000001
  studentId         String
  academicYear      String    @default("2026-27")
  programId         String?
  semesterId        String?
  preferredHostelId String?
  roomPreference    String?   @default("NON_AC")
  reason            String?
  documents         String?
  status            String    @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_REVIEW | ELIGIBLE | WAITLISTED | APPROVED | REJECTED | ALLOTTED | CANCELLED
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model HostelAllotment {
  id               String    @id @default(uuid())
  allotmentNo      String    @unique // HST-ALL-2026-000001
  studentId        String
  hostelId         String
  roomId           String
  bedId            String
  academicYear     String    @default("2026-27")
  allottedDate     DateTime  @default(now())
  allottedByUserId String?
  checkInDate      DateTime?
  expectedCheckout DateTime?
  vacatedDate      DateTime?
  status           String    @default("ACTIVE") // ACTIVE | VACATED | TRANSFERRED | CANCELLED
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel           Hostel              @relation(fields: [hostelId], references: [id])
  room             HostelRoom          @relation(fields: [roomId], references: [id])
  bed              HostelBed           @relation(fields: [bedId], references: [id])
  transfers        HostelTransfer[]
  checkInOuts      HostelCheckInOut[]

  @@index([studentId])
  @@index([hostelId])
  @@index([status])
}

model HostelTransfer {
  id            String   @id @default(uuid())
  transferNo    String   @unique // TRF-HST-2026-000001
  allotmentId   String
  fromBedId     String
  toBedId       String
  reason        String
  approvedBy    String?
  status        String   @default("COMPLETED") // PENDING | COMPLETED | REJECTED
  createdAt     DateTime @default(now())

  allotment     HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@index([allotmentId])
}

model HostelCheckInOut {
  id              String   @id @default(uuid())
  allotmentId     String
  actionType      String   // CHECK_IN | CHECK_OUT
  actionTime      DateTime @default(now())
  roomInspection  String?  @default("GOOD") // GOOD | REPAIR_REQUIRED | DAMAGES_NOTED
  noDuesCleared   Boolean  @default(true)
  remarks         String?

  allotment       HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@index([allotmentId])
}

model HostelAttendance {
  id             String   @id @default(uuid())
  studentId      String
  hostelId       String
  attendanceDate DateTime @db.Date
  status         String   @default("PRESENT") // PRESENT | ABSENT | OUT | ON_LEAVE
  remarks        String?
  createdAt      DateTime @default(now())

  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel         Hostel   @relation(fields: [hostelId], references: [id])

  @@unique([studentId, attendanceDate])
  @@index([hostelId])
  @@index([attendanceDate])
}

model OutpassRequest {
  id               String    @id @default(uuid())
  outpassNo        String    @unique // OUT-2026-000001
  studentId        String
  fromDate         DateTime
  toDate           DateTime
  purpose          String
  destination      String
  contactNumber    String
  guardianContact  String?
  qrData           String?
  verificationCode String?
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED | ACTIVE | COMPLETED | OVERDUE
  approvedBy       String?
  approvedAt       DateTime?
  actualReturnTime DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model HostelVisitor {
  id           String    @id @default(uuid())
  visitorName  String
  studentId    String
  hostelId     String
  relation     String    // PARENT | GUARDIAN | SIBLING | RELATIVE | FRIEND
  purpose      String
  contactPhone String
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  idProofType  String?   @default("AADHAAR")
  status       String    @default("CHECKED_IN") // EXPECTED | CHECKED_IN | CHECKED_OUT | CANCELLED
  approvedBy   String?
  createdAt    DateTime  @default(now())

  hostel       Hostel    @relation(fields: [hostelId], references: [id])

  @@index([studentId])
  @@index([hostelId])
  @@index([status])
}

model HostelComplaint {
  id          String   @id @default(uuid())
  complaintNo String   @unique // CMP-HST-2026-000001
  studentId   String
  hostelId    String
  roomId      String?
  category    String   // MAINTENANCE | ELECTRICAL | PLUMBING | CLEANING | FOOD_MESS | INTERNET | SECURITY | OTHER
  description String
  priority    String   @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status      String   @default("SUBMITTED") // SUBMITTED | ASSIGNED | IN_PROGRESS | RESOLVED | CLOSED
  assignedTo  String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel      Hostel      @relation(fields: [hostelId], references: [id])
  room        HostelRoom? @relation(fields: [roomId], references: [id])

  @@index([studentId])
  @@index([hostelId])
  @@index([status])
}

model HostelMaintenance {
  id            String   @id @default(uuid())
  maintenanceNo String   @unique // MNT-HST-2026-000001
  hostelId      String
  roomId        String?
  issue         String
  priority      String   @default("NORMAL")
  assignedStaff String?
  cost          Decimal? @db.Decimal(10, 2)
  status        String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hostel        Hostel   @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
  @@index([status])
}

model Mess {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  capacity    Int      @default(200)
  cateringBy  String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  menus       MessMenu[]
  enrollments MessEnrollment[]
}

model MessMenu {
  id        String   @id @default(uuid())
  messId    String
  dayOfWeek String   // MONDAY | TUESDAY | WEDNESDAY | THURSDAY | FRIDAY | SATURDAY | SUNDAY
  mealType  String   // BREAKFAST | LUNCH | SNACKS | DINNER
  items     String   // e.g. "Poha, Tea, Sambhar Rice, Paneer Butter Masala, Roti, Salad"
  createdAt DateTime @default(now())

  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([messId, dayOfWeek, mealType])
}

model MessEnrollment {
  id           String   @id @default(uuid())
  messId       String
  studentId    String
  planType     String   @default("MONTHLY") // MONTHLY | SEMESTER | ANNUAL
  dietType     String   @default("VEG")     // VEG | JAIN | SPECIAL
  status       String   @default("ACTIVE")
  enrolledDate DateTime @default(now())

  mess         Mess     @relation(fields: [messId], references: [id])
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([messId])
}

// --- UNIVERSITY TRANSPORT & FLEET MANAGEMENT ---

model Vehicle {
  id                 String   @id @default(uuid())
  registrationNumber String   @unique // GJ-01-AB-1234
  vehicleType        String   @default("BUS") // BUS | MINI_BUS | VAN | AMBULANCE | CAR
  makeModel          String   // e.g. "Tata Starbus 40 Seater"
  capacity           Int      @default(40)
  fuelType           String   @default("DIESEL") // DIESEL | CNG | ELECTRIC | PETROL
  purchaseDate       DateTime?
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  pucExpiry          DateTime?
  permitExpiry       DateTime?
  status             String   @default("ACTIVE") // ACTIVE | INACTIVE | MAINTENANCE | ACCIDENT | RETIRED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  allotments   TransportAllotment[]
  trips        TransportTrip[]
  maintenances VehicleMaintenance[]
  documents    VehicleDocument[]
  incidents    TransportIncident[]
  complaints   TransportComplaint[]

  @@index([status])
}

model DriverProfile {
  id             String    @id @default(uuid())
  driverName     String
  contactNumber  String
  licenseNumber  String    @unique
  licenseType    String    @default("HEAVY_VEHICLE") // HEAVY_VEHICLE | COMMERCIAL | LIGHT_VEHICLE
  licenseExpiry  DateTime?
  experienceYears Decimal  @default(5) @db.Decimal(4, 1)
  status         String    @default("ACTIVE") // ACTIVE | ON_LEAVE | SUSPENDED | INACTIVE
  createdAt      DateTime  @default(now())

  trips          TransportTrip[]
  incidents      TransportIncident[]

  @@index([status])
}

model TransportRoute {
  id              String   @id @default(uuid())
  routeNumber     String   @unique // R-101
  routeName       String   // e.g. "Ahmedabad ISKCON — Gandhinagar Campus"
  startPoint      String
  endPoint        String
  distanceKm      Decimal  @default(25) @db.Decimal(6, 2)
  estDurationMins Int      @default(45)
  monthlyFee      Decimal  @default(2500) @db.Decimal(10, 2)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  stops           TransportStop[]
  applications    TransportApplication[]
  allotments      TransportAllotment[]
  trips           TransportTrip[]
  complaints      TransportComplaint[]

  @@index([status])
}

model TransportStop {
  id         String   @id @default(uuid())
  routeId    String
  stopName   String
  location   String?
  sequence   Int      @default(1)
  pickupTime String   // e.g. "07:30 AM"
  dropTime   String   // e.g. "05:45 PM"
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  route        TransportRoute         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  applications TransportApplication[]
  allotments   TransportAllotment[]

  @@unique([routeId, sequence])
  @@index([routeId])
}

model TransportApplication {
  id            String   @id @default(uuid())
  applicationNo String   @unique // TRN-APP-2026-000001
  studentId     String
  routeId       String
  stopId        String
  academicYear  String   @default("2026-27")
  status        String   @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | ALLOCATED | CANCELLED
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route         TransportRoute @relation(fields: [routeId], references: [id])
  stop          TransportStop  @relation(fields: [stopId], references: [id])

  @@index([studentId])
  @@index([routeId])
  @@index([status])
}

model TransportAllotment {
  id            String    @id @default(uuid())
  allotmentNo   String    @unique // TRN-ALL-2026-000001
  studentId     String
  vehicleId     String
  routeId       String
  stopId        String
  academicYear  String    @default("2026-27")
  allocatedDate DateTime  @default(now())
  status        String    @default("ACTIVE") // ACTIVE | CANCELLED | TRANSFERRED
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  route         TransportRoute @relation(fields: [routeId], references: [id])
  stop          TransportStop  @relation(fields: [stopId], references: [id])
  passes        TransportPass[]

  @@index([studentId])
  @@index([vehicleId])
  @@index([routeId])
  @@index([status])
}

model TransportPass {
  id               String   @id @default(uuid())
  passNo           String   @unique // TP-2026-000001
  allotmentId      String
  studentId        String
  validFrom        DateTime @default(now())
  validTo          DateTime
  verificationCode String?
  qrData           String?
  status           String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | SUSPENDED
  issuedAt         DateTime @default(now())

  allotment        TransportAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)
  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([allotmentId])
}

model TransportTrip {
  id          String   @id @default(uuid())
  tripNo      String   @unique // TRP-2026-000001
  vehicleId   String
  routeId     String
  driverId    String?
  tripDate    DateTime @db.Date
  startTime   String   // e.g. "07:00 AM"
  endTime     String?  // e.g. "08:30 AM"
  tripType    String   @default("PICKUP") // PICKUP | DROP | SPECIAL | EVENT | OTHER
  status      String   @default("SCHEDULED") // SCHEDULED | IN_TRANSIT | COMPLETED | DELAYED | CANCELLED
  createdAt   DateTime @default(now())

  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  route       TransportRoute @relation(fields: [routeId], references: [id])
  driver      DriverProfile? @relation(fields: [driverId], references: [id])
  attendances TransportAttendance[]

  @@index([vehicleId])
  @@index([routeId])
  @@index([tripDate])
}

model TransportAttendance {
  id             String   @id @default(uuid())
  tripId         String
  studentId      String
  attendanceDate DateTime @db.Date
  status         String   @default("BOARDED") // BOARDED | NOT_BOARDED
  boardedTime    DateTime @default(now())

  trip           TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tripId, studentId])
  @@index([studentId])
}

model VehicleMaintenance {
  id            String    @id @default(uuid())
  maintenanceNo String    @unique // MNT-VEH-2026-000001
  vehicleId     String
  issue         String
  priority      String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  assignedStaff String?
  estimatedCost Decimal?  @db.Decimal(10, 2)
  actualCost    Decimal?  @db.Decimal(10, 2)
  status        String    @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
}

model VehicleDocument {
  id         String    @id @default(uuid())
  vehicleId  String
  docType    String    // INSURANCE | PERMIT | FITNESS | PUC | RC_BOOK
  docNumber  String
  expiryDate DateTime?
  docUrl     String?
  status     String    @default("VALID") // VALID | EXPIRING_SOON | EXPIRED

  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([docType])
}

model TransportIncident {
  id          String   @id @default(uuid())
  incidentNo  String   @unique // INC-TRN-2026-000001
  vehicleId   String
  driverId    String?
  date        DateTime @default(now())
  location    String
  description String
  damage      String?
  status      String   @default("REPORTED") // REPORTED | UNDER_INVESTIGATION | RESOLVED | CLOSED
  createdAt   DateTime @default(now())

  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  driver      DriverProfile? @relation(fields: [driverId], references: [id])

  @@index([vehicleId])
}

model TransportComplaint {
  id          String   @id @default(uuid())
  complaintNo String   @unique // CMP-TRN-2026-000001
  studentId   String
  routeId     String?
  vehicleId   String?
  description String
  priority    String   @default("NORMAL")
  status      String   @default("SUBMITTED") // SUBMITTED | IN_PROGRESS | RESOLVED | CLOSED
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route       TransportRoute? @relation(fields: [routeId], references: [id])
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id])

  @@index([studentId])
  @@index([status])
}

// --- LIBRARY & LEARNING RESOURCE MANAGEMENT ---

model Library {
  id          String   @id @default(uuid())
  code        String   @unique // LIB-CENTRAL, LIB-ENG
  name        String
  instituteId String?
  location    String?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute   Institute?       @relation(fields: [instituteId], references: [id])
  sections    LibrarySection[]
  copies      BookCopy[]

  @@index([instituteId])
  @@index([status])
}

model LibrarySection {
  id          String   @id @default(uuid())
  libraryId   String
  code        String   // SEC-CS, SEC-REF
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  library     Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  shelves     LibraryShelf[]

  @@unique([libraryId, code])
  @@index([libraryId])
}

model LibraryShelf {
  id          String   @id @default(uuid())
  sectionId   String
  shelfNumber String   // RACK-A1, SHELF-04
  floor       String?  @default("Ground")
  capacity    Int      @default(100)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     LibrarySection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  copies      BookCopy[]

  @@index([sectionId])
}

model LibraryCategory {
  id               String   @id @default(uuid())
  code             String   @unique // CS, IT, MECH, BIO, PHARM, LAW, MGMT, GEN
  name             String
  description      String?
  parentCategoryId String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  books            Book[]

  @@index([status])
}

model LibraryAuthor {
  id        String   @id @default(uuid())
  name      String
  bio       String?
  email     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books     Book[]

  @@index([name])
}

model LibraryPublisher {
  id        String   @id @default(uuid())
  name      String
  address   String?
  contact   String?
  email     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books     Book[]

  @@index([name])
}

model Book {
  id              String   @id @default(uuid())
  isbn            String   @unique
  title           String
  subtitle        String?
  edition         String?
  publicationYear Int?
  language        String   @default("English")
  categoryId      String?
  subjectId       String?
  authorId        String?
  authorName      String
  publisherId     String?
  publisherName   String?
  description     String?
  keywords        String[]
  coverImage      String?
  resourceType    String   @default("BOOK") // BOOK | JOURNAL | MAGAZINE | THESIS | REFERENCE | E_BOOK | DIGITAL_RESOURCE | OTHER
  totalCopies     Int      @default(0)
  availableCopies Int      @default(0)
  status          String   @default("AVAILABLE") // AVAILABLE | ARCHIVED | OUT_OF_STOCK
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        LibraryCategory?   @relation(fields: [categoryId], references: [id])
  subject         Subject?           @relation(fields: [subjectId], references: [id])
  author          LibraryAuthor?     @relation(fields: [authorId], references: [id])
  publisher       LibraryPublisher?  @relation(fields: [publisherId], references: [id])
  copies          BookCopy[]
  reservations    LibraryReservation[]
  digitalResources DigitalResource[]

  @@index([title])
  @@index([authorName])
  @@index([categoryId])
  @@index([subjectId])
  @@index([resourceType])
  @@index([status])
}

model BookCopy {
  id           String    @id @default(uuid())
  accessionNo  String    @unique // ACC-2026-000001
  barcode      String    @unique // BC-10001
  bookId       String
  libraryId    String?
  shelfId      String?
  rack         String?
  purchaseDate DateTime? @default(now())
  cost         Decimal   @default(0) @db.Decimal(10, 2)
  condition    String    @default("NEW") // NEW | GOOD | FAIR | POOR | DAMAGED
  status       String    @default("AVAILABLE") // AVAILABLE | ISSUED | RESERVED | LOST | DAMAGED | REPAIR | WITHDRAWN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  book         Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  library      Library?        @relation(fields: [libraryId], references: [id])
  shelf        LibraryShelf?   @relation(fields: [shelfId], references: [id])
  issues       LibraryIssue[]
  incidents    LibraryIncident[]

  @@index([bookId])
  @@index([libraryId])
  @@index([shelfId])
  @@index([status])
  @@index([barcode])
}

model LibraryMembership {
  id           String    @id @default(uuid())
  membershipNo String    @unique // LIB-MEM-2026-000001
  userId       String
  memberType   String    // STUDENT | FACULTY | EMPLOYEE
  instituteId  String?
  departmentId String?
