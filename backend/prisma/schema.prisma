  status       String    @default("ACTIVE") // ACTIVE | SUSPENDED | EXPIRED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues       LibraryIssue[]
  reservations LibraryReservation[]
  fines        LibraryFine[]
  incidents    LibraryIncident[]

  @@index([userId])
  @@index([memberType])
  @@index([status])
}

model LibraryIssue {
  id             String    @id @default(uuid())
  issueNo        String    @unique // ISS-2026-000001
  memberId       String
  copyId         String
  issueDate      DateTime  @default(now())
  dueDate        DateTime
  returnedDate   DateTime?
  issuedByUserId String?
  renewalCount   Int       @default(0)
  maxRenewals    Int       @default(2)
  fineAmount     Decimal   @default(0) @db.Decimal(10, 2)
  status         String    @default("ISSUED") // ISSUED | RETURNED | OVERDUE | RENEWED | LOST
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  member         LibraryMembership @relation(fields: [memberId], references: [id])
  copy           BookCopy          @relation(fields: [copyId], references: [id])
  returnRecord   LibraryReturn?
  fines          LibraryFine[]

  @@index([memberId])
  @@index([copyId])
  @@index([status])
  @@index([dueDate])
}

model LibraryReturn {
  id               String   @id @default(uuid())
  issueId          String   @unique
  returnDate       DateTime @default(now())
  receivedByUserId String?
  condition        String   @default("GOOD") // GOOD | DAMAGED | REPAIR
  fineCharged      Decimal  @default(0) @db.Decimal(10, 2)
  remarks          String?
  createdAt        DateTime @default(now())

  issue            LibraryIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model LibraryReservation {
  id            String    @id @default(uuid())
  reservationNo String    @unique // RES-2026-000001
  memberId      String
  bookId        String
  requestDate   DateTime  @default(now())
  expiryDate    DateTime
  status        String    @default("ACTIVE") // ACTIVE | FULFILLED | EXPIRED | CANCELLED
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  member        LibraryMembership @relation(fields: [memberId], references: [id])
  book          Book              @relation(fields: [bookId], references: [id])

  @@index([memberId])
  @@index([bookId])
  @@index([status])
}

model LibraryFine {
  id             String    @id @default(uuid())
  fineNo         String    @unique // FINE-2026-000001
  issueId        String?
  memberId       String
  amount         Decimal   @db.Decimal(10, 2)
  reason         String    // OVERDUE | LOST_BOOK | DAMAGED_BOOK | LATE_FEE
  status         String    @default("UNPAID") // UNPAID | PAID | WAIVED
  transactionRef String?
  paidAt         DateTime?
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  issue          LibraryIssue?     @relation(fields: [issueId], references: [id])
  member         LibraryMembership @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([issueId])
  @@index([status])
}

model LibraryIncident {
  id                String    @id @default(uuid())
  incidentNo        String    @unique // INC-2026-000001
  memberId          String
  copyId            String
  incidentType      String    // LOST | DAMAGED
  incidentDate      DateTime  @default(now())
  description       String
  evidenceDocId     String?
