  status            String    @default("REPORTED") // REPORTED | VERIFIED | CHARGED | RESOLVED | WRITTEN_OFF
  resolvedAt        DateTime?
  resolutionRemarks String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  member            LibraryMembership @relation(fields: [memberId], references: [id])
  copy              BookCopy          @relation(fields: [copyId], references: [id])

  @@index([memberId])
  @@index([copyId])
  @@index([status])
}

model DigitalResource {
  id            String   @id @default(uuid())
  resourceCode  String   @unique // DIG-2026-000001
  title         String
  description   String?
  resourceType  String   // E_BOOK | PDF | JOURNAL | RESEARCH_PAPER | VIDEO | EXTERNAL_RESOURCE
