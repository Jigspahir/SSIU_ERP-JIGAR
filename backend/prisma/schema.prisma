// --- UNIVERSITY COMMUNICATION & OFFICIAL CORRESPONDENCE ---

model CommunicationType {
  id          String   @id @default(uuid())
  code        String   @unique // LETTER | CIRCULAR | NOTICE | OFFICE_ORDER | MEMO | INVITATION | APPOINTMENT | PERMISSION | APPROVAL | WARNING | CERTIFICATE | REPLY | REQUEST | INTERNAL
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  communications Communication[]
}

model Communication {
  id                String    @id @default(uuid())
  referenceNo       String    @unique // COMM-2026-000001
  inwardNo          String?   // INW-2026-000001
  outwardNo         String?   // OUT-2026-000001
  direction         String    @default("INTERNAL") // INWARD | OUTWARD | INTERNAL
  communicationTypeId String
  subject           String
  content           String?
  priority          String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status            String    @default("RECEIVED") // DRAFT | RECEIVED | UNDER_REVIEW | APPROVAL_PENDING | APPROVED | REJECTED | ASSIGNED | IN_PROCESS | FORWARDED | REPLIED | SENT | CLOSED | ARCHIVED
  
  // Sender Details
  senderName        String?
  senderOrganization String?
  senderEmail       String?
  receivedThrough   String?   // EMAIL | POST | COURIER | HAND_DELIVERY | WEBSITE | OTHER
  receivedDate      DateTime? @db.Date

  // Department & Institute Scoping
  instituteId       String?
  departmentId      String?
  creatorUserId     String
  assignedUserId    String?
  dueDate           DateTime? @db.Date
  
  // Digital Signature Foundation
  signatureStatus   String    @default("NOT_CONFIGURED") // NOT_CONFIGURED | PENDING | SIGNED | VERIFIED
  signedByUserId    String?
  signedDate        DateTime?

  documentUrl       String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  communicationType CommunicationType @relation(fields: [communicationTypeId], references: [id])
  creator           User              @relation("CommCreator", fields: [creatorUserId], references: [id])

  recipients        CommunicationRecipient[]
  assignments       CommunicationAssignment[]
  movements         CommunicationMovement[]
  approvals         CommunicationApproval[]
  dispatchRecords   DispatchRecord[]

  @@index([referenceNo])
  @@index([direction])
  @@index([status])
  @@index([creatorUserId])
  @@index([assignedUserId])
  @@index([departmentId])
}

model CommunicationRecipient {
  id              String   @id @default(uuid())
  communicationId String
  recipientType   String   @default("TO") // TO | CC | BCC
  recipientUserId String?
  recipientEmail  String?
  recipientName   String?
  isRead          Boolean  @default(false)
  readAt          DateTime?

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model CommunicationAssignment {
  id              String   @id @default(uuid())
  communicationId String
  assignedByUserId String
  assignedToUserId String
  departmentId    String?
  instruction     String?
  dueDate         DateTime? @db.Date
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  assignedAt      DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model CommunicationMovement {
  id              String   @id @default(uuid())
  communicationId String
  movedByUserId   String
  fromOffice      String
  toOffice        String
  actionTaken     String   // CREATED | REGISTERED | FORWARDED | REJECTED | RETURNED | APPROVED | CLOSED
  remarks         String?
  movedAt         DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model CommunicationApproval {
  id              String   @id @default(uuid())
  communicationId String
  approverUserId  String
  stepNumber      Int      @default(1)
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | RETURNED
  comments        String?
  actedAt         DateTime?
  createdAt       DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model DispatchRecord {
  id              String    @id @default(uuid())
  communicationId String
  dispatchNo      String    @unique // DSP-2026-000001
  dispatchDate    DateTime  @default(now())
  recipientName   String
  recipientAddress String?
  dispatchMethod  String    @default("COURIER") // POST | COURIER | HAND_DELIVERY | EMAIL | OTHER
  trackingNo      String?
  courierAgency   String?
  deliveryStatus  String    @default("PREPARED") // PREPARED | DISPATCHED | IN_TRANSIT | DELIVERED | RETURNED
  deliveredDate   DateTime?
  remarks         String?
  createdAt       DateTime  @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@index([dispatchNo])
  @@index([deliveryStatus])
}

// --- DIGITAL STUDENT SERVICE DESK & CERTIFICATES ---

model StudentService {
  id                  String   @id @default(uuid())
  code                String   @unique // BONAFIDE | CHARACTER_CERT | TRANSCRIPT | MIGRATION | TRANSFER_CERT | ID_CARD | DUPLICATE_ID | FEE_RECEIPT | NO_DUES | EXAM_REQ | RESULT_REQ | INTERNSHIP_LETTER | PERMISSION_LETTER | SCHOLARSHIP_REQ | HOSTEL_REQ | TRANSPORT_REQ | LIBRARY_REQ | GENERAL_REQ
  name                String
  description         String?
  category            String   @default("CERTIFICATE") // CERTIFICATE | ACADEMIC | ADMINISTRATIVE | FINANCE | HOSTEL | TRANSPORT | EXAMINATION | OTHER
  expectedDays        Int      @default(3)
  feeAmount           Decimal  @default(0) @db.Decimal(10, 2)
  responsibleRoleCode String   @default("STUDENT_SECTION") // STUDENT_SECTION | HOD | HOI | REGISTRAR | EXAM_SECTION | FINANCE_OFFICER
  responsibleDept     String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  requirements StudentServiceRequirement[]
  requests     StudentServiceRequest[]
  certificates Certificate[]

  @@index([category])
  @@index([isActive])
}

model StudentServiceRequirement {
  id               String   @id @default(uuid())
  serviceId        String
  documentName     String
  isRequired       Boolean  @default(true)
  allowedFileTypes String   @default("PDF,JPG,PNG")
  maxSizeBytes     Int      @default(5242880) // 5MB
  instructions     String?
  createdAt        DateTime @default(now())

  service StudentService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model StudentServiceRequest {
  id                 String    @id @default(uuid())
  requestNo          String    @unique // REQ-2026-000001
  studentId          String
  serviceId          String
  submissionDate     DateTime  @default(now())
  status             String    @default("SUBMITTED") // SUBMITTED | UNDER_VERIFICATION | FORWARDED | APPROVAL_PENDING | APPROVED | REJECTED | RETURNED | PROCESSING | READY | COMPLETED | CANCELLED
  currentStage       String    @default("SUBMITTED")
  currentAuthorityRole String  @default("STUDENT_SECTION")
  currentAssigneeId  String?
  purpose            String?
  remarks            String?
  rejectionReason    String?
  dueDate            DateTime? @db.Date
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  service StudentService @relation(fields: [serviceId], references: [id])

  documents    StudentServiceRequestDocument[]
  certificates Certificate[]

  @@index([requestNo])
  @@index([studentId])
  @@index([serviceId])
  @@index([status])
  @@index([currentAuthorityRole])
}

model StudentServiceRequestDocument {
  id          String   @id @default(uuid())
  requestId   String
  name        String
  documentUrl String
  fileSize    Int?
  fileType    String?
  uploadedAt  DateTime @default(now())

  request StudentServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Certificate {
  id                String    @id @default(uuid())
  certificateNumber String    @unique // CERT-2026-000001
  requestId         String?
  studentId         String
  serviceId         String
  certificateType   String    // BONAFIDE | CHARACTER | TRANSFER | MIGRATION | TRANSCRIPT | OTHER
  title             String
  academicYearCode  String    @default("2026-27")
  issueDate         DateTime  @default(now())
  validUntil        DateTime?
  status            String    @default("VALID") // VALID | REVOKED | EXPIRED
  signatoryTitle    String    @default("Registrar / Authorized Signatory")
  verificationHash  String    @unique
  certificateUrl    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  service StudentService         @relation(fields: [serviceId], references: [id])
  request StudentServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([certificateNumber])
  @@index([studentId])
  @@index([verificationHash])
  @@index([status])
}

// --- ADMISSION & ENROLLMENT MANAGEMENT ---

model AdmissionCycle {
  id               String   @id @default(uuid())
  code             String   @unique // ADM-2026-REG
  academicYearCode String   @default("2026-27")
  name             String
  admissionType    String   @default("REGULAR") // REGULAR | MERIT | MANAGEMENT | INTERNATIONAL | TRANSFER | LATERAL_ENTRY | OTHER
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  applicationFee   Decimal  @default(500) @db.Decimal(10, 2)
  status           String   @default("ACTIVE") // ACTIVE | CLOSED | UPCOMING
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications     AdmissionApplication[]

  @@index([academicYearCode])
  @@index([status])
}

model AdmissionInquiry {
  id                    String    @id @default(uuid())
  inquiryNo             String    @unique // INQ-2026-000001
  applicantName         String
  mobile                String
  email                 String?
  city                  String?
  state                 String?
  interestedInstituteId String?
  interestedProgramId   String?
  source                String    @default("WEBSITE") // WEBSITE | WALK_IN | SOCIAL_MEDIA | EDUCATION_FAIR | REFERRAL | OTHER
  counsellorUserId      String?
  inquiryDate           DateTime  @default(now())
  nextFollowUpDate      DateTime? @db.Date
  status                String    @default("NEW") // NEW | CONTACTED | COUNSELLING | FOLLOW_UP | CONVERTED | NOT_INTERESTED | CLOSED
  remarks               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  counsellings          CounsellingRecord[]
  applications          AdmissionApplication[]

  @@index([inquiryNo])
  @@index([status])
  @@index([counsellorUserId])
  @@index([interestedProgramId])
}

model CounsellingRecord {
  id               String   @id @default(uuid())
  inquiryId        String
  counsellorUserId String
  counsellingDate  DateTime @default(now())
  discussionPoints String
  applicantNeed    String?
  nextFollowUpDate DateTime? @db.Date
  remarks          String?
  createdAt        DateTime @default(now())

  inquiry AdmissionInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([counsellorUserId])
}

model AdmissionApplication {
  id               String    @id @default(uuid())
  applicationNo    String    @unique // APP-2026-000001
  inquiryId        String?
  admissionCycleId String
  instituteId      String
  programId        String
  admissionType    String    @default("REGULAR") // REGULAR | MERIT | MANAGEMENT | INTERNATIONAL | TRANSFER | LATERAL_ENTRY
  
  // Applicant Details
  firstName        String
  middleName       String?
  lastName         String
  email            String
  mobile           String
  gender           String?
  dateOfBirth      DateTime? @db.Date
  category         String?   @default("GENERAL") // GENERAL | SC | ST | OBC | EWS
  city             String?
  state            String?
  address          String?
  
  // Academic Qualification
  qualifyingExam   String?   // 12th / Diploma / Bachelor
  qualifyingBoard  String?
  passingYear      Int?
  percentage       Decimal?  @db.Decimal(5, 2)
  
  // Status Tracking
  status           String    @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_VERIFICATION | DOCUMENT_QUERY | ELIGIBILITY_PENDING | ELIGIBLE | NOT_ELIGIBLE | APPROVAL_PENDING | APPROVED | REJECTED | ADMISSION_CONFIRMED | ENROLLED
  isFeePaid        Boolean   @default(false)
  feeAmountPaid    Decimal   @default(0) @db.Decimal(10, 2)
  feeReceiptNo     String?
  
  submissionDate   DateTime  @default(now())
  verifiedByUserId String?
  verifiedAt       DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  rejectionReason  String?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  admissionCycle   AdmissionCycle               @relation(fields: [admissionCycleId], references: [id])
  inquiry          AdmissionInquiry?            @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  documents        AdmissionApplicationDocument[]
  eligibilityResults EligibilityResult[]
  approvals        AdmissionApproval[]
  enrollment       Enrollment?

  @@index([applicationNo])
  @@index([status])
  @@index([programId])
  @@index([instituteId])
  @@index([admissionCycleId])
}

model AdmissionApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String
  documentType  String   // 10TH_MARKSHEET | 12TH_MARKSHEET | ID_PROOF | TC | MIGRATION | PHOTO | OTHER
  documentUrl   String
  status        String   @default("UPLOADED") // UPLOADED | VERIFIED | REJECTED | QUERY_RAISED
  verifiedBy    String?
  remarks       String?
  uploadedAt    DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model EligibilityRule {
  id               String   @id @default(uuid())
  programId        String
  minQualification String   // 12TH_SCIENCE | 12TH_COMMERCE | 12TH_ANY | DIPLOMA | GRADUATION
  minPercentage    Decimal  @db.Decimal(5, 2)
  requiredSubjects String?  // e.g. "Physics, Mathematics, Chemistry"
  entranceRequired Boolean  @default(false)
  entranceExamName String?  // e.g. "GUJCET, JEE, NEET"
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  @@index([programId])
}

model EligibilityResult {
  id            String   @id @default(uuid())
  applicationId String
  isEligible    Boolean
  calculatedPct Decimal? @db.Decimal(5, 2)
  evaluationLog String?
  evaluatedBy   String   // SYSTEM | USER_ID
  evaluatedAt   DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model AdmissionApproval {
  id             String   @id @default(uuid())
  applicationId  String
  approverRole   String   // ADMISSION_MANAGER | DIRECTOR_ADMISSION | HOI | REGISTRAR
  approverUserId String
  status         String   // APPROVED | REJECTED | RETURNED
  comments       String?
  actedAt        DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Enrollment {
  id               String   @id @default(uuid())
  applicationId    String   @unique
  studentId        String   @unique
  enrollmentNo     String   @unique // 2026SSIUCE0101
  academicYearCode String   @default("2026-27")
  enrolledAt       DateTime @default(now())
  enrolledBy       String   // User ID

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([enrollmentNo])
  @@index([studentId])
}

// --- UNIVERSITY EXAMINATION, EVALUATION & RESULT MANAGEMENT ---

model ExamCentre {
  id          String   @id @default(uuid())
  code        String   @unique // CENTRE-01
  name        String
  building    String
  address     String?
  capacity    Int      @default(500)
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       ExamRoom[]

  @@index([status])
}

model ExamRoom {
  id          String   @id @default(uuid())
  centreId    String
  roomNumber  String
  floor       Int      @default(1)
  capacity    Int      @default(40)
  hasCCTV     Boolean  @default(true)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  centre      ExamCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  invigilations InvigilatorAssignment[]

  @@unique([centreId, roomNumber])
  @@index([centreId])
}

model InvigilatorAssignment {
  id             String   @id @default(uuid())
  examScheduleId String
  roomId         String
  facultyUserId  String
  dutyDate       DateTime @db.Date
  reportingTime  String   // e.g. "09:30 AM"
  status         String   @default("ASSIGNED") // ASSIGNED | CONFIRMED | REPORTED | REPLACED | ABSENT
  remarks        String?
  createdAt      DateTime @default(now())

  room           ExamRoom @relation(fields: [roomId], references: [id])

  @@index([examScheduleId])
  @@index([facultyUserId])
  @@index([roomId])
}

model ExamAttendance {
  id             String   @id @default(uuid())
  examScheduleId String
  studentId      String
  status         String   @default("PRESENT") // PRESENT | ABSENT | MALPRACTICE | MEDICAL | OTHER
  answerSheetNo  String?
  markedByUserId String?
  markedAt       DateTime @default(now())
  remarks        String?

  @@unique([examScheduleId, studentId])
  @@index([examScheduleId])
  @@index([studentId])
}

model HallTicket {
  id               String   @id @default(uuid())
  hallTicketNo     String   @unique // HT-2026-000001
  examId           String
  studentId        String
  examSessionName  String   @default("Summer 2026 Regular/Remedial")
  verificationCode String   @unique
  issueDate        DateTime @default(now())
  status           String   @default("GENERATED") // GENERATED | ISSUED | BLOCKED | CANCELLED
  qrData           String?
  downloadUrl      String?
  createdAt        DateTime @default(now())

  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([hallTicketNo])
  @@index([examId])
  @@index([studentId])
  @@index([verificationCode])
}

model EvaluationAssignment {
  id             String   @id @default(uuid())
  examScheduleId String
  subjectId      String
  examinerUserId String
  totalBundles   Int      @default(1)
  totalScripts   Int      @default(40)
  evaluatedCount Int      @default(0)
  status         String   @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | SUBMITTED | VERIFIED | LOCKED
  assignedDate   DateTime @default(now())
  submittedDate  DateTime?
  verifiedBy     String?
  lockedAt       DateTime?

  @@index([examScheduleId])
  @@index([examinerUserId])
  @@index([subjectId])
}

model ResultSummary {
  id               String   @id @default(uuid())
  studentId        String
  examId           String
  semesterNumber   Int
  academicYearCode String   @default("2026-27")
  totalCredits     Decimal  @default(0) @db.Decimal(5, 2)
  earnedCredits    Decimal  @default(0) @db.Decimal(5, 2)
  totalMarks       Decimal  @default(0) @db.Decimal(6, 2)
  maxMarks         Decimal  @default(0) @db.Decimal(6, 2)
  percentage       Decimal? @db.Decimal(5, 2)
  sgpa             Decimal? @db.Decimal(4, 2)
  cgpa             Decimal? @db.Decimal(4, 2)
  backlogsCount    Int      @default(0)
  resultStatus     String   @default("PASS") // PASS | FAIL | ATKT | WITHHELD
  isPublished      Boolean  @default(false)
  publishedAt      DateTime?
  marksheetNo      String?  @unique // MS-2026-000001
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([examId])
  @@index([resultStatus])
}

model RevaluationRequest {
  id               String   @id @default(uuid())
  requestNo        String   @unique // REV-2026-000001
  studentId        String
  examResultId     String
  subjectId        String
  requestType      String   @default("REVALUATION") // RECHECKING | REVALUATION | COPY_VIEW
  originalMarks    Decimal  @db.Decimal(6, 2)
  revisedMarks     Decimal? @db.Decimal(6, 2)
  feeAmount        Decimal  @default(500) @db.Decimal(10, 2)
  isFeePaid        Boolean  @default(false)
  status           String   @default("SUBMITTED") // SUBMITTED | ASSIGNED | EVALUATED | UPDATED | REJECTED
  assignedExaminer String?
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([requestNo])
  @@index([studentId])
  @@index([examResultId])
}

// --- UNIVERSITY HR, EMPLOYEE, PAYROLL & RECRUITMENT ---

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  documentType String    // APPOINTMENT_LETTER | JOINING_DOC | QUALIFICATION | EXPERIENCE | ID_PROOF | PROMOTION | INCREMENT | OTHER
  title        String
  documentUrl  String
  issueDate    DateTime  @default(now())
  expiryDate   DateTime?
  status       String    @default("VERIFIED") // VERIFIED | PENDING | EXPIRED | REJECTED
  verifiedBy   String?
  createdAt    DateTime  @default(now())

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model DutyRequest {
  id             String    @id @default(uuid())
  requestNo      String    @unique // DTY-2026-000001
  employeeId     String
  dutyType       String    // WORK_FROM_HOME | ON_DUTY | CONFERENCE | UNIVERSITY_DUTY | OFFICIAL_VISIT
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  totalDays      Int       @default(1)
  purpose        String
  status         String    @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED | CANCELLED
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model Holiday {
  id           String   @id @default(uuid())
  name         String
  holidayDate  DateTime @db.Date
  type         String   @default("NATIONAL") // NATIONAL | FESTIVAL | RESTRICTED | UNIVERSITY
  instituteId  String?
  academicYear String   @default("2026-27")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  @@index([holidayDate])
  @@index([academicYear])
}

model AppraisalCycle {
  id          String   @id @default(uuid())
  name        String   // e.g. "Annual Appraisal 2025-26"
  year        String   @default("2026-27")
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED | CLOSED
  createdAt   DateTime @default(now())

  reviews     AppraisalReview[]

  @@index([year])
  @@index([status])
}

model AppraisalReview {
  id                 String    @id @default(uuid())
  appraisalCycleId   String
  employeeId         String
  reviewerUserId     String?
  selfAssessment     String?
  goalsAchieved      String?
  reviewerComments   String?
  selfRating         Decimal?  @db.Decimal(3, 1) // e.g. 4.5
  finalRating        Decimal?  @db.Decimal(3, 1)
  recommendation     String?   // PROMOTION | INCREMENT | CONFIRMATION | RETAIN
  status             String    @default("SELF_REVIEW_PENDING") // SELF_REVIEW_PENDING | REVIEW_PENDING | HR_VERIFICATION | COMPLETED
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appraisalCycle     AppraisalCycle @relation(fields: [appraisalCycleId], references: [id], onDelete: Cascade)
  employee           Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([appraisalCycleId, employeeId])
  @@index([employeeId])
  @@index([status])
}

model PayrollPeriod {
  id           String   @id @default(uuid())
  code         String   @unique // PAY-2026-08
  month        Int      // 1-12
  year         Int      // 2026
  status       String   @default("DRAFT") // DRAFT | PROCESSED | APPROVED | DISBURSED
  processedAt  DateTime?
  disbursedAt  DateTime?
  totalGross   Decimal  @default(0) @db.Decimal(14, 2)
  totalNet     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  records      PayrollRecord[]
  payslips     Payslip[]

  @@unique([month, year])
  @@index([status])
}

model PayrollRecord {
  id              String   @id @default(uuid())
  payrollPeriodId String
  employeeId      String
  basicPay        Decimal  @db.Decimal(12, 2)
  allowances      Decimal  @default(0) @db.Decimal(12, 2)
  deductions      Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary     Decimal  @db.Decimal(12, 2)
  netSalary       Decimal  @db.Decimal(12, 2)
  paymentStatus   String   @default("PENDING") // PENDING | PAID | HOLD
  paymentMode     String   @default("BANK_TRANSFER")
  transactionRef  String?
  paidDate        DateTime?

  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@index([paymentStatus])
}

model Payslip {
  id              String   @id @default(uuid())
  payslipNo       String   @unique // PSL-2026-08-000001
  payrollPeriodId String
  employeeId      String
  basic           Decimal  @db.Decimal(12, 2)
  hra             Decimal  @default(0) @db.Decimal(12, 2)
  specialAllow    Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction     Decimal  @default(0) @db.Decimal(12, 2)
  taxDeduction    Decimal  @default(0) @db.Decimal(12, 2)
  grossAmount     Decimal  @db.Decimal(12, 2)
  netAmount       Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @default(now())
  pdfUrl          String?
  createdAt       DateTime @default(now())

  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([payrollPeriodId])
}

model JobRequisition {
  id               String   @id @default(uuid())
  requisitionNo    String   @unique // REQ-HR-2026-0001
  departmentId     String
  instituteId      String
  positionTitle    String
  employmentType   String   @default("FULL_TIME") // FULL_TIME | ADHOC | VISITING
  vacanciesCount   Int      @default(1)
  minExperience    Int      @default(2) // years
  qualificationReq String
  status           String   @default("OPEN") // OPEN | APPROVED | CLOSED | CANCELLED
  createdAt        DateTime @default(now())

  applications     JobApplication[]

  @@index([departmentId])
  @@index([status])
}

model JobApplication {
  id               String   @id @default(uuid())
  jobRequisitionId String
  candidateName    String
  email            String
  phone            String
  experienceYears  Decimal  @db.Decimal(4, 1)
  highestQual      String
  resumeUrl        String?
  status           String   @default("APPLIED") // APPLIED | SHORTLISTED | INTERVIEW_SCHEDULED | SELECTED | OFFERED | JOINED | REJECTED
  appliedDate      DateTime @default(now())

  jobRequisition   JobRequisition @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)
  interviews       Interview[]
  offer            Offer?

  @@index([jobRequisitionId])
  @@index([status])
}

model Interview {
  id               String   @id @default(uuid())
  jobApplicationId String
  interviewDate    DateTime
  interviewType    String   @default("TECHNICAL") // SCREENING | TECHNICAL | HR | DEAN_INTERVIEW
  interviewerUserId String?
  rating           Decimal? @db.Decimal(3, 1) // 1-5
  feedback         String?
  status           String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  createdAt        DateTime @default(now())

  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
}

model Offer {
  id               String   @id @default(uuid())
  jobApplicationId String   @unique
  offeredPosition  String
  offeredSalary    Decimal  @db.Decimal(12, 2)
  joiningDate      DateTime @db.Date
  offerLetterUrl   String?
  status           String   @default("OFFERED") // OFFERED | ACCEPTED | DECLINED | JOINED
  createdAt        DateTime @default(now())

  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Resignation {
  id               String    @id @default(uuid())
  resignationNo    String    @unique // RES-2026-000001
  employeeId       String
  submissionDate   DateTime  @default(now())
  requestedLWD     DateTime  @db.Date // Last Working Day
  officialLWD      DateTime? @db.Date
  reason           String
  status           String    @default("SUBMITTED") // SUBMITTED | HOD_APPROVED | HR_APPROVED | CLEARANCE_PENDING | COMPLETED | WITHDRAWN
  exitInterview    String?
  approvedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clearance        ExitClearance?

  @@index([employeeId])
  @@index([status])
}

model ExitClearance {
  id               String   @id @default(uuid())
  resignationId    String   @unique
  departmentNoDue  Boolean  @default(false)
  libraryNoDue     Boolean  @default(false)
  financeNoDue     Boolean  @default(false)
  itAssetsReturned Boolean  @default(false)
  hrFinalSettled   Boolean  @default(false)
  remarks          String?
  clearedAt        DateTime?

  resignation      Resignation @relation(fields: [resignationId], references: [id], onDelete: Cascade)
}









