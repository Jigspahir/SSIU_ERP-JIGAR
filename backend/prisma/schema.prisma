  @@index([programId])
  @@index([subjectId])
  @@index([status])
}

model LibraryNotice {
  id          String   @id @default(uuid())
  noticeNo    String   @unique // NOT-2026-000001
  title       String
  description String
  audience    String   @default("ALL") // ALL | STUDENTS | FACULTY | EMPLOYEES | INSTITUTE | DEPARTMENT | PROGRAM
  targetId    String?
  priority    String   @default("NORMAL") // NORMAL | URGENT | HIGH
  startDate   DateTime @default(now())
  endDate     DateTime
