{
  "expo": {
    "name": "Swarrnim University ERP",
    "slug": "swarrnim-university-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "swarrnimerp",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.edu.swarrnim.erp",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Swarrnim ERP",
        "NSCameraUsageDescription": "Allow Swarrnim ERP to access your camera to capture and upload profile photos and verification documents.",
        "NSPhotoLibraryUsageDescription": "Allow Swarrnim ERP to access your photo library to attach identity and academic documents."
      }
    },
    "android": {
      "package": "in.edu.swarrnim.erp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A2540"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "extra": {

      "eas": {
        "projectId": "swarrnim-erp-mobile-app"
      }
    }
  }
}
